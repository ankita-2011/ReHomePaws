# Server Environment Variables
# Copy this file to .env and fill in your actual values

# MongoDB Connection Strings
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rehomepaws?retryWrites=true&w=majority
LOCAL_MONGODB_URI=mongodb://localhost:27017/rehomepaws

# Application Security
PORT=8080
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SECRET=your_admin_secret_key_here
FRONTEND_URL=http://localhost:5173

# Email Service (Google Apps Script / Gmail Webhook)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Uploads directory for local fallback
UPLOADS_DIR=uploads